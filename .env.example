# Environment Variables — JANGAN di-push ke repository!
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai.

# MySQL root password (wajib diisi)
MYSQL_ROOT_PASSWORD=your_root_password_here

# Database name
DB_NAME=tododb

# Database user
DB_USER=todouser

# Database password
DB_PASSWORD=your_secure_password_here
